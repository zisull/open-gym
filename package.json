{
  "name": "open-gym",
  "version": "1.0.0",
  "description": "开放球馆 · OPEN GYM：纯前端 3D 第一人称球馆（篮球 / 影院 / 台球），离线双击即玩",
  "main": "index.js",
  "scripts": {
    "build": "esbuild src/main.js --bundle --format=iife --outfile=dist/game.js --target=es2020 --sourcemap",
    "watch": "esbuild src/main.js --bundle --format=iife --outfile=dist/game.js --target=es2020 --sourcemap --watch",
    "audio": "node tools/gen_audio.js",
    "setup": "node tools/setup.js",
    "walls": "node tools/gen_wall_manifest.js",
    "videos": "node tools/gen_video_manifest.js",
    "regress": "node tools/regress.js",
    "audit": "node tools/audit_cfg.js && node tools/audit_exports.js",
    "shot": "node tools/shot.js"
  },
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "cannon-es": "^0.20.0",
    "three": "^0.160.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "playwright-core": "^1.63.0"
  }
}
